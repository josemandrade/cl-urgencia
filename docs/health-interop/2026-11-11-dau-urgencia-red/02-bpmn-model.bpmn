<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_dau" targetNamespace="http://health-interop-superpowers/dau-urgencia-red" exporter="health-interop-superpowers" exporterVersion="0.5.0">
  <bpmn:collaboration id="Collaboration_dau">
    <bpmn:participant id="p_est" name="Establecimiento informante — Unidad de Urgencia" processRef="proc_est" />
    <bpmn:participant id="p_plat" name="Bus de Interoperabilidad MINSAL y Repositorio FHIR" processRef="proc_plat" />
    <bpmn:participant id="p_receptor" name="Punto de la red receptor (APS / Especialidad / Otro hospital / SAMU)" processRef="proc_receptor" />
    <bpmn:messageFlow id="mf_pi1" name="PI-1 · Bundle de alta o abandono (datos 1–8)" sourceRef="t_publicar" targetRef="msgstart_b" />
    <bpmn:messageFlow id="mf_pi3a" name="PI-3 · Solicitud del DAU" sourceRef="t_consultar" targetRef="msgstart_dau" />
    <bpmn:messageFlow id="mf_pi3b" name="PI-3 · DAU en PDF" sourceRef="t_enviar" targetRef="t_recuperar" />
  <bpmn:messageFlow id="mf_pi0" name="PI-0 · Bundle de admisión (Encounter arrived)" sourceRef="t_publicar_admision" targetRef="msgstart_b" /><bpmn:messageFlow id="mf_pi2a" name="PI-2 · Consultar episodios (búsqueda FHIR o suscripción)" sourceRef="t_consultar" targetRef="msgstart_c" /><bpmn:messageFlow id="mf_pi2b" name="PI-2 · Episodios entregados" sourceRef="endmsg_c" targetRef="t_consultar" /></bpmn:collaboration>
  <bpmn:process id="proc_est" name="Establecimiento informante" isExecutable="false">
    <bpmn:laneSet id="lanes_est">
      <bpmn:lane id="lane_admision" name="Admisión / Registro">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_llegada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_identificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_motivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_aperturar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_informar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_constatar_nea</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>gw_vital</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane_categ" name="Categorización / Selector de Demanda">
        <bpmn:flowNodeRef>t_categorizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_asignar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_cat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_esperar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_nea</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>be_nea2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane_clinico" name="Equipo clínico de Urgencia">
        <bpmn:flowNodeRef>t_atender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_fuga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_constatar_fuga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_desenlace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_medicamentos</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_informar_paciente</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane_his" name="HIS / RCE">
        <bpmn:flowNodeRef>t_crear_episodio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dao_episodio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dao_dau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>msgstart_dau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endmsg_dau</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>t_publicar_admision</bpmn:flowNodeRef><bpmn:flowNodeRef>t_cerrar_fallecido</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Llega persona a urgencia">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t_llegada" name="Recepcionar al usuario: registrar llegada y procedencia">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_identificar" name="Identificar a la persona (doble verificador)">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_datos" name="Registrar datos sociodemográficos y previsión">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_motivo" name="Solicitar y registrar motivo de consulta">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_aperturar" name="Aperturar DAU e instalar brazalete de identificación">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_crear_episodio" name="Crear episodio DAU en el HIS (ID DAU)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="doa_episodio">
        <bpmn:targetRef>dao_episodio</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="dao_episodio" name="Episodio DAU (ID DAU)" dataObjectRef="do_episodio" />
    <bpmn:dataObject id="do_episodio" name="Episodio DAU (ID DAU)" />
    <bpmn:task id="t_informar" name="Informar llegada al Selector de Demanda">
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_categorizar" name="Categorizar paciente (C1–C5)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_asignar" name="Asignar box / unidad de atención">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_cat" name="¿Categoría?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_esperar" name="Esperar atención">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="be_nea" name="Paciente se retira (NEA)" attachedToRef="t_esperar" cancelActivity="true">
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="eed_nea" />
    </bpmn:boundaryEvent>
    <bpmn:task id="t_constatar_nea" name="Constatar abandono (NEA)">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    <bpmn:incoming>f38</bpmn:incoming></bpmn:task>
    <bpmn:task id="t_atender" name="Atender clínicamente">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    <bpmn:incoming>f36</bpmn:incoming></bpmn:task>
    <bpmn:boundaryEvent id="be_fuga" name="Paciente se retira (fuga)" attachedToRef="t_atender" cancelActivity="true">
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="eed_fuga" />
    </bpmn:boundaryEvent>
    <bpmn:task id="t_constatar_fuga" name="Constatar abandono (fuga)">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_desenlace" name="¿Cómo termina la atención?" default="f21">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
    <bpmn:outgoing>f41</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:textAnnotation id="ann_terminador">
      <bpmn:text>Decisión del Terminador (médico u odontólogo)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_term" sourceRef="ann_terminador" targetRef="gw_desenlace" />
    <bpmn:task id="t_medicamentos" name="Indicar medicamentos al alta">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_cerrar" name="Cerrar DAU y generar PDF">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
      <bpmn:dataInputAssociation id="dia_episodio">
        <bpmn:sourceRef>dao_episodio</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="doa_dau">
        <bpmn:targetRef>dao_dau</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="dao_dau" name="DAU en PDF" dataObjectRef="do_dau" />
    <bpmn:dataObject id="do_dau" name="DAU en PDF" />
    <bpmn:task id="t_publicar" name="Publicar aviso mínimo a la red">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
      <bpmn:dataInputAssociation id="dia_dau">
        <bpmn:sourceRef>dao_dau</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    <bpmn:incoming>f42</bpmn:incoming></bpmn:task>
    <bpmn:endEvent id="end_a" name="Episodio cerrado / aviso publicado">
      <bpmn:incoming>f23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="msgstart_dau" name="Solicitud de DAU recibida">
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_dau" />
    </bpmn:startEvent>
    <bpmn:task id="t_enviar" name="Enviar DAU en PDF">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endmsg_dau" name="DAU enviado">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:messageEventDefinition id="med_dau_end" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="gw_vital" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_llegada" targetRef="t_identificar" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_identificar" targetRef="t_datos" />
    <bpmn:sequenceFlow id="f4" sourceRef="t_datos" targetRef="t_motivo" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_motivo" targetRef="t_aperturar" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_aperturar" targetRef="t_crear_episodio" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_informar" targetRef="t_categorizar" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_categorizar" targetRef="t_asignar" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_asignar" targetRef="gw_cat" />
    <bpmn:sequenceFlow id="f11" name="C2–C5" sourceRef="gw_cat" targetRef="t_esperar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">categoría en C2..C5</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f12" name="C1" sourceRef="gw_cat" targetRef="t_atender">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">categoría = C1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f13" sourceRef="t_esperar" targetRef="t_atender" />
    <bpmn:sequenceFlow id="f14" sourceRef="be_nea" targetRef="t_constatar_nea" />
    <bpmn:sequenceFlow id="f15" name="Abandono (NEA)" sourceRef="t_constatar_nea" targetRef="gw_desenlace" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_atender" targetRef="t_informar_paciente" />
    <bpmn:sequenceFlow id="f17" sourceRef="be_fuga" targetRef="t_constatar_fuga" />
    <bpmn:sequenceFlow id="f18" name="Abandono (fuga)" sourceRef="t_constatar_fuga" targetRef="gw_desenlace" />
    <bpmn:sequenceFlow id="f19" name="Alta" sourceRef="gw_desenlace" targetRef="t_medicamentos">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">desenlace = alta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f20" sourceRef="t_medicamentos" targetRef="t_cerrar" />
    <bpmn:sequenceFlow id="f21" name="Abandono" sourceRef="gw_desenlace" targetRef="t_cerrar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">desenlace = abandono</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f22" sourceRef="t_cerrar" targetRef="t_publicar" />
    <bpmn:sequenceFlow id="f23" sourceRef="t_publicar" targetRef="end_a" />
    <bpmn:sequenceFlow id="f24" sourceRef="msgstart_dau" targetRef="t_enviar" />
    <bpmn:sequenceFlow id="f25" sourceRef="t_enviar" targetRef="endmsg_dau" />
  <bpmn:exclusiveGateway id="gw_vital" name="¿Emergencia vital?"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f35</bpmn:outgoing><bpmn:outgoing>f36</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="t_publicar_admision" name="Publicar evento de admisión a la red"><bpmn:incoming>f33</bpmn:incoming><bpmn:outgoing>f34</bpmn:outgoing></bpmn:task><bpmn:task id="t_informar_paciente" name="Informar al paciente o familiares"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f37</bpmn:outgoing></bpmn:task><bpmn:boundaryEvent id="be_nea2" name="Paciente se retira (NEA)" attachedToRef="t_categorizar" cancelActivity="true"><bpmn:outgoing>f38</bpmn:outgoing><bpmn:escalationEventDefinition id="eed_nea2" /></bpmn:boundaryEvent><bpmn:sequenceFlow id="f33" sourceRef="t_crear_episodio" targetRef="t_publicar_admision" /><bpmn:sequenceFlow id="f34" sourceRef="t_publicar_admision" targetRef="t_informar" /><bpmn:sequenceFlow id="f35" sourceRef="gw_vital" targetRef="t_llegada" name="No"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sin emergencia vital</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f36" sourceRef="gw_vital" targetRef="t_atender" name="Sí, emergencia vital"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">emergencia vital</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f37" sourceRef="t_informar_paciente" targetRef="gw_desenlace" /><bpmn:sequenceFlow id="f38" sourceRef="be_nea2" targetRef="t_constatar_nea" /><bpmn:task id="t_cerrar_fallecido" name="Cerrar DAU (fallecido)"><bpmn:incoming>f41</bpmn:incoming><bpmn:outgoing>f42</bpmn:outgoing><bpmn:dataInputAssociation id="dia_episodio_fallecido"><bpmn:sourceRef>dao_episodio</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="doa_dau_fallecido"><bpmn:targetRef>dao_dau</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:task><bpmn:sequenceFlow id="f41" sourceRef="gw_desenlace" targetRef="t_cerrar_fallecido" name="Fallecimiento"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">desenlace = fallecimiento</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f42" sourceRef="t_cerrar_fallecido" targetRef="t_publicar" /></bpmn:process>
  <bpmn:process id="proc_plat" name="Bus de Interoperabilidad MINSAL y Repositorio FHIR" isExecutable="false">
    <bpmn:laneSet id="lanes_plat">
      <bpmn:lane id="lane_plat" name="Bus / Repositorio">
        <bpmn:flowNodeRef>msgstart_b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_plataforma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endmsg_b</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>msgstart_c</bpmn:flowNodeRef><bpmn:flowNodeRef>t_responder</bpmn:flowNodeRef><bpmn:flowNodeRef>endmsg_c</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="msgstart_b" name="Transacción recibida (admisión, alta o abandono)">
      <bpmn:outgoing>f26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_b" />
    </bpmn:startEvent>
    <bpmn:task id="t_plataforma" name="Recibir la transacción y aplicarla en el repositorio">
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endmsg_b" name="Episodio disponible en el repositorio">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:messageEventDefinition id="med_b_end" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f26" sourceRef="msgstart_b" targetRef="t_plataforma" />
    <bpmn:sequenceFlow id="f27" sourceRef="t_plataforma" targetRef="endmsg_b" />
  <bpmn:startEvent id="msgstart_c" name="Consulta FHIR recibida"><bpmn:outgoing>f39</bpmn:outgoing><bpmn:messageEventDefinition id="med_c" /></bpmn:startEvent><bpmn:task id="t_responder" name="Responder la consulta de episodios"><bpmn:incoming>f39</bpmn:incoming><bpmn:outgoing>f40</bpmn:outgoing></bpmn:task><bpmn:endEvent id="endmsg_c" name="Episodios entregados"><bpmn:incoming>f40</bpmn:incoming><bpmn:messageEventDefinition id="med_c_end" /></bpmn:endEvent><bpmn:sequenceFlow id="f39" sourceRef="msgstart_c" targetRef="t_responder" /><bpmn:sequenceFlow id="f40" sourceRef="t_responder" targetRef="endmsg_c" /></bpmn:process>
  <bpmn:process id="proc_receptor" name="Punto de la red receptor" isExecutable="false">
    <bpmn:laneSet id="lanes_receptor">
      <bpmn:lane id="lane_receptor" name="Equipo receptor">
        <bpmn:flowNodeRef>t_consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_detalle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recuperar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_seguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="t_consultar" name="Consultar episodios en el repositorio">
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_detalle" name="¿Necesita el detalle clínico?">
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_recuperar" name="Solicitar y recibir DAU en PDF">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_seguimiento" name="Realizar seguimiento / continuar atención">
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Fin">
      <bpmn:incoming>f32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f28" sourceRef="t_consultar" targetRef="gw_detalle" />
    <bpmn:sequenceFlow id="f29" name="Sí" sourceRef="gw_detalle" targetRef="t_recuperar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">necesita detalle = sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f30" sourceRef="t_recuperar" targetRef="t_seguimiento" />
    <bpmn:sequenceFlow id="f31" name="No" sourceRef="gw_detalle" targetRef="t_seguimiento">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">necesita detalle = no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f32" sourceRef="t_seguimiento" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_dau">
    <bpmndi:BPMNPlane id="BPMNPlane_dau" bpmnElement="Collaboration_dau">
